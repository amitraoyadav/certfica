# =====================================================================
# PARIVAHAN SCRAPPERS - PRODUCTION ENVIRONMENT CONFIGURATION (VERCEL)
# =====================================================================
# Configure these variables in your Vercel Project Dashboard:
# Settings -> Environment Variables -> Production & Preview

# ---------------------------------------------------------------------
# 1. CORE AUTHENTICATION & SESSION SECURITY
# ---------------------------------------------------------------------
# Cryptographic secret for signing session tokens and HMAC verification
SESSION_SECRET=

# Initial / Fallback password for Main Core Admin (default: wearescrappers)
CORE_ADMIN_INITIAL_PASSWORD=wearescrappers
MAIN_ADMIN_PASSWORD=wearescrappers

# Credentials for Certificate Maker (Normal Login)
ADMIN_USERNAME=pscrappers
ADMIN_PASSWORD=Scrap123

# Secondary password for sensitive administrative actions
ADMIN_PROTECTED_PASSWORD=
ADMIN_DELETE_PASSWORD=

# ---------------------------------------------------------------------
# 2. FIREBASE FIRESTORE CONFIGURATION (PERMANENT PRODUCTION STORAGE)
# ---------------------------------------------------------------------
# Firebase Project ID (e.g. gen-lang-client-0059461259)
FIREBASE_PROJECT_ID=gen-lang-client-0059461259

# Firestore Database ID (e.g. ai-studio-parivahanscrappe-6de1b59b-dcec-4d6e-8133-a73555223c5e)
FIREBASE_DATABASE_ID=ai-studio-parivahanscrappe-6de1b59b-dcec-4d6e-8133-a73555223c5e
FIRESTORE_DATABASE_ID=ai-studio-parivahanscrappe-6de1b59b-dcec-4d6e-8133-a73555223c5e

# Firebase Web API Key for client SDK
FIREBASE_API_KEY=

# Firebase Service Account Credentials (For server-side Firestore operations)
# Provide either full JSON string OR individual fields:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Enable live server-side database writes (true for live issuance)
ENABLE_LIVE_CERTIFICATE_ISSUANCE=true

# ---------------------------------------------------------------------
# 3. SCHEDULED CRON BACKUP SECURITY
# ---------------------------------------------------------------------
# Shared secret for Vercel Cron endpoint authorization (/api/cron/daily-backup)
CRON_SECRET=

# ---------------------------------------------------------------------
# 4. OPTIONAL EXTERNAL & AI ENHANCEMENTS
# ---------------------------------------------------------------------
# Optional: Gemini API Key for deep optical/AI document parsing
GEMINI_API_KEY=

# Optional: Live Database URL for historical data seeding/sync
LIVE_DATABASE_URL=