# 1. Original Production Website Connection (Read-Only Source & Sync)
LIVE_DATABASE_URL="https://crm-parivahanscrappers.ai.studio"

# 2. Firebase Firestore Server-Side Credentials (Permanent Persistent Database)
FIREBASE_PROJECT_ID="gen-lang-client-0059461259"
FIREBASE_DATABASE_ID="ai-studio-parivahanscrappe-6de1b59b-dcec-4d6e-8133-a73555223c5e"
FIREBASE_CLIENT_EMAIL="REPLACE_WITH_FIREBASE_ADMIN_SDK_CLIENT_EMAIL"
FIREBASE_PRIVATE_KEY="REPLACE_WITH_FIREBASE_ADMIN_SDK_PRIVATE_KEY"
# Optional alternative: provide the entire Service Account JSON in one variable:
FIREBASE_SERVICE_ACCOUNT_JSON=""

# 3. Optional PostgreSQL Connection (Neon / Vercel Postgres / Cloud SQL)
DATABASE_URL=""

# 4. Server-Side Session & Authentication Secrets (Never exposed to frontend)
SESSION_SECRET="REPLACE_WITH_CRYPTOGRAPHIC_SESSION_SECRET"
ADMIN_USERNAME="pscrappers"
ADMIN_PASSWORD="REPLACE_WITH_ADMIN_PASSWORD"
MAIN_ADMIN_PASSWORD="REPLACE_WITH_MAIN_ADMIN_PASSWORD"
ADMIN_DELETE_PASSWORD="REPLACE_WITH_ADMIN_DELETE_PASSWORD"

# 5. Runtime Application URL
APP_URL="MY_APP_URL"
